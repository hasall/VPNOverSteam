{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch VPNOverSteamApp as server",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/VPNOverSteamApp.exe",
            "args": [
                "-s",
                "-ln",
                "MyLobby",
                "-lp",
                "MyPassword"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Launch VPNOverSteamApp as client",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/VPNOverSteamApp.exe",
            "args": [
                "-c",
                "-ln",
                "MyLobby",
                "-lp",
                "MyPassword"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Attach to gdbserver",
            "type": "cppdbg",
            "request": "launch",
            "miDebuggerServerAddress": "localhost:1234",
            "miDebuggerPath": "/usr/bin/gdb",
            "program": "${workspaceFolder}/build/VPNOverSteamApp",
            "cwd": "${workspaceFolder}/build",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/"
                },
                {
                    "name": "STEAM_CLIENT_PATH",
                    "value": "${workspaceFolder}/"
                }
            ]
        }
    ]
}